@echo off
title تشغيل مستكشف الحسابات
cd /d "%~dp0"

echo ============================================
echo   مستكشف الحسابات - جاري التشغيل...
echo ============================================
echo.

:: تشغيل السيرفر في نافذة مصغرة
echo [1/3] جاري تشغيل خادم التطبيق...
start "خادم مستكشف الحسابات" /min start.bat

:: الانتظار لتهيئة السيرفر
echo [2/3] جاري الانتظار لتهيئة النظام...
timeout /t 3 >nul

:: فتح المتصفح
echo [3/3] جاري فتح برنامج مستكشف الحسابات في المتصفح...
start http://localhost:3050

echo.
echo ============================================
echo   [OK] تم تشغيل البرنامج بنجاح!
echo   يمكنك إغلاق هذه النافذة الآن.
echo   لإيقاف البرنامج، قم بإغلاق نافذة السيرفر المصغرة.
echo ============================================
echo.
timeout /t 5 >nul
